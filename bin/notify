#!/usr/bin/env bash
# Single entry point. Every hook, wrapper or watcher calls this:
#
#   notify <agent> <subcommand>      # the agent's native payload on stdin
#
# Exits 0 in every scenario, on purpose: a hook that hangs or fails is worse
# than one that does not exist.
set -uo pipefail

# Resolve symlinks in the script path to find the real AV_ROOT.
# Uses three tiers: readlink -f, plain readlink in loop, ls -ld parsing.
# Detects cycles and logs unresolvable symlinks to avoid silent wrong-root.
_resolve_symlink() {
  local path="$1" max_hops=40

  # Tier 1: readlink -f (resolves full chain at once)
  if command -v readlink >/dev/null 2>&1; then
    local resolved
    resolved="$(readlink -f "$path" 2>/dev/null)"
    if [ $? -eq 0 ] && [ -e "$resolved" ]; then
      printf '%s' "$resolved"
      return 0
    fi
  fi

  # Tier 2: plain readlink in a loop (one hop at a time, relative target aware)
  if command -v readlink >/dev/null 2>&1; then
    local current="$path" target count_t2=0
    while [ $count_t2 -lt $max_hops ]; do
      target="$(readlink "$current" 2>/dev/null)" || break
      if [ -z "$target" ]; then break; fi
      # If target is relative, resolve relative to current's directory
      if [[ "$target" != /* ]]; then
        target="$(cd "$(dirname "$current")" 2>/dev/null && pwd)/$target"
      fi
      current="$target"
      count_t2=$((count_t2 + 1))
    done
    if [ $count_t2 -gt 0 ] && [ $count_t2 -lt $max_hops ]; then
      printf '%s' "$current"
      return 0
    fi
  fi

  # Tier 3: parse ls -ld output (works on minimal systems)
  if command -v ls >/dev/null 2>&1; then
    local current="$path" target ls_out count_t3=0
    while [ $count_t3 -lt $max_hops ]; do
      ls_out="$(ls -ld "$current" 2>/dev/null)" || break
      # If not a symlink, we're done
      [[ "$ls_out" != l* ]] && break
      # Extract symlink target from "... -> target" format
      target="${ls_out##* -> }"
      if [ -z "$target" ] || [ "$target" = "$ls_out" ]; then break; fi
      # If target is relative, resolve relative to current's directory
      if [[ "$target" != /* ]]; then
        target="$(cd "$(dirname "$current")" 2>/dev/null && pwd)/$target"
      fi
      current="$target"
      count_t3=$((count_t3 + 1))
    done
    if [ $count_t3 -gt 0 ] && [ $count_t3 -lt $max_hops ]; then
      printf '%s' "$current"
      return 0
    fi
  fi

  # All tiers failed; if it's a symlink, we have a problem (cycle or unresolvable)
  if [ -L "$path" ] 2>/dev/null; then
    return 1
  fi

  # Not a symlink; return as-is
  printf '%s' "$path"
  return 0
}

_script_path="${BASH_SOURCE[0]}"
_script_path="$(_resolve_symlink "$_script_path")" || {
  # Symlink resolution failed; log and give up. Use AV_STATE_DIR if set, else default.
  _state_dir="${AV_STATE_DIR:-${HOME}/.local/state/agent-voice}"
  _log_msg="$(date '+%Y-%m-%d %H:%M:%S') ?            -          ignored: bin/notify symlink unresolvable (cycle or broken target)"
  mkdir -p "$_state_dir" 2>/dev/null
  printf '%s\n' "$_log_msg" >> "$_state_dir/events.log" 2>/dev/null
  exit 0
}

AV_ROOT="$(cd "$(dirname "$_script_path")/.." && pwd)"
export AV_ROOT
unset _script_path _resolve_symlink _state_dir _log_msg
. "$AV_ROOT/config.sh"
. "$AV_ROOT/lib/core.sh"

agent="${1:-}"
subcommand="${2:-}"

if [ -z "$agent" ] || [ -z "$subcommand" ]; then
  av_log "${agent:-?}" "-" "ignored: usage is notify <agent> <subcommand>"
  exit 0
fi

adapter="$AV_ROOT/adapters/$agent.sh"
if [ ! -x "$adapter" ]; then
  av_log "$agent" "-" "no adapter at $adapter"
  exit 0
fi

"$adapter" "$subcommand" | av_handle
exit 0
